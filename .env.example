# NanoUptake Analyzer - Supabase Cloud & Render Deployment Configuration
# Set these in your Render Web Service -> Environment Variables tab

# OPTION 1: Single Connection String (Recommended for Render)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI) -> Transaction Mode (Port 6543):
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# OPTION 2: Discrete Environment Variables (Alternative)
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# Optional Supabase API & Project Reference:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Application Settings
APP_ENV=production
SECRET_KEY=nanouptake_analyzer_secure_token_secret_2026
