# NanoUptake Analyzer - Supabase Cloud Configuration Example

# Supabase API Credentials
SUPABASE_URL=https://xyz-your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase PostgreSQL Connection Credentials
# Option 1: Unified PostgreSQL Connection URI (Standard on Render / Supabase)
# DATABASE_URL=postgresql://postgres.xyz-your-supabase-project:your_supabase_db_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Discrete PostgreSQL Parameters
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xyz-your-supabase-project
SUPABASE_DB_PASSWORD=your_supabase_db_password

# Application Settings
APP_ENV=production
SECRET_KEY=nanouptake_analyzer_secure_token_secret_2026

